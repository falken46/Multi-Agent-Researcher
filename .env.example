# ---- LLM ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
LLM_TIMEOUT=60
LLM_MAX_RETRY=3
MODEL_PRICING={"deepseek-v4-flash":{"input_cache_hit":0.02,"input_cache_miss":1.0,"output":2.0},"deepseek-v4-pro":{"input_cache_hit":0.025,"input_cache_miss":3.0,"output":6.0}}
MODEL_PRICING_CURRENCY=CNY
MODEL_PRICING_VERSION=2026-08-24

# ---- 联网搜索 ----
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-xxx

# ---- 检索层 ----
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REMOTE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30
# 向量库后端：chroma | milvus
# 保留 chroma 是为了 Phase 17 的 A/B 对照（换库后 R 轨结果必须与 Chroma 版基本一致）
VECTOR_BACKEND=chroma
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=deepresearch_kb
# 两种形态都支持：
#   http://localhost:19530   独立 Milvus 服务（docker compose）
#   data/milvus_lite.db      Milvus Lite 本地文件（测试 / 无 Docker 环境）
# 注意变量名是 MILVUS_ENDPOINT 不是 MILVUS_URI：后者会被 pymilvus 自己占用，
# 它在 import 时就读该变量并强制按 http 解析，填本地文件路径会直接崩。
MILVUS_ENDPOINT=http://localhost:19530
MILVUS_COLLECTION=deepresearch_kb
MILVUS_TOKEN=
BM25_INDEX_PATH=data/bm25/index.pkl
KB_DIR=data/kb
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=20
VECTOR_SEARCH_ENABLED=true
BM25_SEARCH_ENABLED=true
RERANK_BACKEND=onnx
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=5
RRF_K=60
KB_SCORE_THRESHOLD=0.35

# ---- 编排 ----
RESEARCH_CONCURRENCY=3
MAX_RETRY=2
MAX_REVISION=2
QUALITY_THRESHOLD=0.7
CHECKPOINT_DB=data/checkpoints.sqlite

# ---- 业务数据持久化（Phase 19）----
# 留空 = 不落库，全链路静默跳过（保住"无外部依赖也能跑完整离线测试"）
#   PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/deepresearch
#   SQLite    : sqlite:///data/app.db
DATABASE_URL=
DB_ECHO=false

# ---- 接口鉴权（Phase 20）----
# 形如 API_KEYS=key1:研究所,key2:合规部
# 留空 = 不鉴权（默认），所有请求放行、调用主体记为 anonymous
API_KEYS=

# ---- 可观测 ----
TRACE_DIR=traces
TRACE_ENABLED=true

# ---- OpenTelemetry 导出（Phase 20，可选）----
# 留空 = 只写本地 JSONL。JSONL 永远是主路径，OTel 是叠加的一层，
# 所以没有任何外部服务时项目照常完整可跑。
#
# 用 OTel 标准而不是绑定某家 SDK：Laminar 是 OTel 原生，Langfuse 也吃 OTLP，
# 换后端只改下面两行，代码不动。
#
#   Laminar（托管）:
#     OTEL_ENDPOINT=https://api.lmnr.ai:8443/v1/traces
#     OTEL_HEADERS=Authorization=Bearer <你的 project api key>
#
#   Laminar（自托管 docker compose，默认端口）:
#     OTEL_ENDPOINT=http://localhost:8000/v1/traces
#
#   Langfuse（托管）:
#     OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
#     OTEL_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
#
# 具体路径与鉴权格式以各自官方文档为准，首次接入时请核对。
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=deepresearch-agent
OTEL_HEADERS=
OTEL_TIMEOUT=10

# ---- 前端 ----
BACKEND_URL=http://127.0.0.1:8000
